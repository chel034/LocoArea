.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries/
.idea/libraries/

# Keystore files
*.jks
*.keystore

# External native build folder created in Android Studio 2.2 and later
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline/

# fastlane
fastlane/

# Fabric Crashlytics
crashlytics.properties
crashlytics-build.properties
fabric.properties

### Gradle ###
.gradle
build/
!build/cache/
!build/wrapper/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties file (.properties files are usually ignored)
!gradle-wrapper.properties

# Lockfile generated by Gradle
*.lockfile

# SpecificGradle
gradle/wrapper/gradle-5.4.1.bin
gradle/wrapper/gradle-5.4.1.zip
